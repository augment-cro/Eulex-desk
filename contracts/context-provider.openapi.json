{
    "openapi": "3.1.0",
    "info": {
        "title": "Context Provider",
        "version": "1.0.0",
        "description": "Optional context provider the Eulex Desk core consults when CONTEXTS_URL is set. IDs are opaque to the core. The /notifications path is implemented BY the core (direction: service -> core)."
    },
    "paths": {
        "/contexts": {
            "get": {
                "summary": "List contexts available to the identified user (picker)",
                "security": [{ "serviceIdentity": [] }],
                "responses": {
                    "200": {
                        "description": "Context summaries",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": { "$ref": "#/components/schemas/ContextSummary" }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/contexts/{id}/resolve": {
            "post": {
                "summary": "Resolve a context into promptable content for one query",
                "security": [{ "serviceIdentity": [] }],
                "parameters": [
                    { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["query"],
                                "properties": {
                                    "query": { "type": "string" },
                                    "format": {
                                        "type": "integer",
                                        "enum": [1, 2],
                                        "description": "2: the core wraps the blocks in its own precedence header/footer, so the provider returns bare per-context blocks. Absent/1: self-contained v1 blocks (legacy cores)."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Assembled promptable content",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ResolveResult" }
                            }
                        }
                    }
                }
            }
        },
        "/notifications": {
            "post": {
                "summary": "Generic notification intake implemented by the CORE (service -> core). The core stores and displays notifications without understanding their semantics.",
                "security": [{ "serviceIdentity": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/NotificationIn" }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "{ ok: true, inserted: n }" },
                    "401": { "description": "Missing/invalid service identity" }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "serviceIdentity": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT — see service-identity.md"
            }
        },
        "schemas": {
            "ContextSummary": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                    "id": { "type": "string", "description": "Opaque to the core" },
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "level": {
                        "type": "string",
                        "enum": ["personal", "system"],
                        "description": "system = published by EULEX for every user (read-only); personal = the user's own or shared"
                    }
                }
            },
            "ResolveResult": {
                "type": "object",
                "required": ["instructions_md", "sources"],
                "properties": {
                    "instructions_md": { "type": "string" },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["id"],
                            "properties": {
                                "id": { "type": "string", "description": "Opaque to the core" },
                                "label": { "type": "string" },
                                "url": { "type": "string" },
                                "kind": {
                                    "type": "string",
                                    "enum": ["legal_instrument", "legal_article", "caselaw", "web", "document"],
                                    "description": "document: id is a core document id (an EULEX-owned file the core adds to the turn's available documents)"
                                },
                                "tier": { "type": "string", "description": "Authority tier: 1–6 or internal" },
                                "status": { "type": "string", "enum": ["final", "draft", "consultation", "living"] },
                                "issuer": { "type": "string" },
                                "published_on": { "type": "string", "description": "YYYY-MM-DD" }
                            }
                        }
                    },
                    "scope_allowlist": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Opaque source IDs the core enforces as a retrieval scope"
                    },
                    "name": { "type": "string" },
                    "level": { "type": "string", "enum": ["personal", "system"] },
                    "answer_mode": {
                        "type": "string",
                        "enum": ["strict", "extended"],
                        "description": "strict: legal retrieval is scoped to scope_allowlist; extended: context sources first, then the general database. The core enforces scope only while at least one active context is strict."
                    },
                    "version_label": { "type": "string" },
                    "draft": { "type": "boolean", "description": "true when an admin resolves an unpublished system-context draft" },
                    "model": { "type": "string", "description": "System contexts only: the model that should answer while the context is active. The core applies it when it knows the id and ignores it otherwise." },
                    "reasoning_effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"], "description": "System contexts only: how hard the model reasons this turn" },
                    "tasks": {
                        "type": "array",
                        "description": "format 2, system contexts only; omitted when the context has none. Workflows the context defines: the core lists them in the system prompt and serves each one's steps through read_workflow (workflow id ctx-<context id>-<task id>). Never part of instructions_md. The context detail of the management API lists the same tasks without prompt_md.",
                        "items": { "$ref": "#/components/schemas/ContextTask" }
                    }
                }
            },
            "ContextTask": {
                "type": "object",
                "required": ["id", "name", "summary", "status", "prompt_md"],
                "description": "Optional fields are omitted when empty, never null. Localized objects carry hr, and en when the context gives it.",
                "properties": {
                    "id": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d{2}$", "description": "Unique within the context, e.g. RT-10" },
                    "name": { "type": "string", "description": "name_i18n.hr — one line" },
                    "name_i18n": { "$ref": "#/components/schemas/LocalizedText" },
                    "summary": { "type": "string", "description": "summary_i18n.hr — one line" },
                    "summary_i18n": { "$ref": "#/components/schemas/LocalizedText" },
                    "when_i18n": { "$ref": "#/components/schemas/LocalizedText", "description": "When to use the task" },
                    "inputs": {
                        "type": "object",
                        "properties": {
                            "required": { "type": "array", "items": { "type": "string" } },
                            "optional": { "type": "array", "items": { "type": "string" } }
                        }
                    },
                    "checks": { "type": "array", "items": { "type": "string" } },
                    "output": {
                        "type": "object",
                        "required": ["kind"],
                        "properties": {
                            "kind": { "type": "string", "enum": ["docx", "xlsx", "chat"] },
                            "name": { "type": "string" },
                            "name_i18n": { "$ref": "#/components/schemas/LocalizedText" }
                        }
                    },
                    "done_when": { "type": "array", "items": { "type": "string" }, "description": "Completion criteria" },
                    "status": { "type": "string", "enum": ["ready", "draft"] },
                    "prompt_md": { "type": "string", "description": "The steps (Markdown)" }
                }
            },
            "LocalizedText": {
                "type": "object",
                "properties": { "hr": { "type": "string" }, "en": { "type": "string" } }
            },
            "NotificationIn": {
                "type": "object",
                "required": ["title"],
                "properties": {
                    "title": { "type": "string", "maxLength": 500 },
                    "body_md": { "type": "string" },
                    "link": { "type": "string" },
                    "user_ids": {
                        "type": "array",
                        "maxItems": 100,
                        "items": { "type": "string", "format": "uuid" }
                    },
                    "context_ref": {
                        "type": "string",
                        "description": "Opaque reference when user fan-out is service-side"
                    }
                }
            }
        }
    }
}
