PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Legal source document proxy (/legal-docs) ────────────────────────────
# Upstream EULEX document APIs for the right-side citation panel (Phase 2).
# EU is public and has a built-in default; HR/FR Cloud Run are private
# (--no-allow-unauthenticated), so the backend mints a Google ID token for
# the service URL — its runtime service account needs roles/run.invoker on
# the HR/FR services. _TOKEN is an optional static-bearer override.
# Unset ⇒ the corresponding legal-source scope is disabled.
# EULEX_EU_API_BASE=https://<your-eu-legal-api>.example.com
# EULEX_HR_API_BASE=https://<your-hr-legal-api>.example.com
# EULEX_FR_API_BASE=https://<your-fr-legal-api>.example.com
# EULEX_EU_API_TOKEN=
# EULEX_HR_API_TOKEN=
# EULEX_FR_API_TOKEN=
# Externally-reachable backend URL. Used to build the OAuth callback URL for
# MCP connectors. Defaults to http://localhost:${PORT} when unset.
BACKEND_PUBLIC_URL=http://localhost:3001

# ── Database (Cloud SQL) ─────────────────────────────────────────────────
# Production: set CLOUD_SQL_CONNECTION_NAME + DB_IAM_USER for IAM auth via
# the Cloud SQL Node.js Connector (no password needed).
CLOUD_SQL_CONNECTION_NAME=your-project:your-region:your-db-instance
DB_IAM_USER=your-service-account@your-project.iam
DB_NAME=mike

# Development: set DATABASE_URL (overrides Cloud SQL Connector).
# Use Cloud SQL Auth Proxy: cloud-sql-proxy <CLOUD_SQL_CONNECTION_NAME> --port 5433
DATABASE_URL=postgresql://mike_app:your-local-password@127.0.0.1:5433/mike

# ── Auth ─────────────────────────────────────────────────────────────────
# Legacy WordPress-OAuth (Ultimate Membership Pro) HS256 JWT secret. Still
# accepted by requireAuth so existing logins keep working during the
# Supabase transition (dual-token). Remove once fully cut over to Supabase.
EULEX_MCP_JWT_SECRET=your-jwt-signing-secret

# Optional dedicated secret for HMAC-signing download tokens and MCP OAuth
# state tokens. If unset, both fall back to EULEX_MCP_JWT_SECRET above. There
# is NO insecure literal fallback — if neither is set, signing fails closed.
# DOWNLOAD_SIGNING_SECRET=

# Optional dedicated 64-char hex (32-byte) key for AES-256-GCM encryption of
# stored integration API keys (integration_accounts). If unset, the key is
# derived from EULEX_MCP_JWT_SECRET. Do NOT change once tokens are encrypted —
# rotating it makes existing ciphertext undecryptable. Fails closed if neither
# this nor EULEX_MCP_JWT_SECRET is set.
# API_KEY_ENCRYPTION_KEY=

# Optional: Ed25519 seed used to sign project export manifests
# (GET /projects/:id/export), so a recipient can tell an untouched manifest
# from an edited one. Generate with: openssl rand -hex 32
# Use a DEDICATED secret — do not reuse DOWNLOAD_SIGNING_SECRET or
# EULEX_MCP_JWT_SECRET. The matching public key is served (unauthenticated)
# at GET /manifest-signing-key. Unset → manifests export with signature:null
# (file hashes still present, the manifest itself just unattested). A
# malformed value stops the backend at boot instead of shipping exports
# that fail later. Rotating the key does not invalidate past exports, but a
# verifier needs the key that was current when the export was made.
# MANIFEST_SIGNING_KEY=

# Supabase Auth (identity only — data stays in Cloud SQL). When set, the
# auth middleware ALSO accepts Supabase access tokens, verifying them via
# the project JWKS (asymmetric ES256). Leave UNSET to disable the Supabase
# path entirely (middleware behaves exactly as the WP-only version).
# No trailing slash.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret (service_role) key — ONLY needed by the user-migration script
# (backend/scripts/migrate-users-to-supabase.ts), never for token
# verification. Keep out of the frontend.
# SUPABASE_SECRET_KEY=sb_secret_...

# Rate limits on POST /auth/pair/redeem (unauthenticated Word add-in code
# redemption — lib/ipRateLimit.ts, issue #148). Fixed 15-minute windows,
# counted in-process (per Cloud Run instance). Attempts allowed per client
# IP per window (default 10), and across ALL IPs per window (default 300)
# as a distributed-guess backstop. Invalid/zero/negative values fall back
# to the defaults.
# AUTH_PAIR_REDEEM_IP_LIMIT=10
# AUTH_PAIR_REDEEM_GLOBAL_LIMIT=300

# ── Built-in MCP servers (mike/mcp.json) ─────────────────────────────────
# Optional absolute path to a JSON file declaring server-side MCP connectors
# that should be loaded on every chat request without appearing in the
# connectors UI. See <repo>/mike/README.md for the format. When unset the
# loader searches ./mike/mcp.json, ../mike/mcp.json and /app/mike/mcp.json.
# MIKE_MCP_CONFIG=/secrets/mike-mcp.json

# ── Object Storage (Google Cloud Storage) ───────────────────────────────
# On Cloud Run the default service account is used automatically via ADC —
# no credentials needed when the SA has the Storage Object Admin role.
GCS_BUCKET_NAME=your-gcs-bucket-name

# ── AI / LLM API Keys ───────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
OPENROUTER_API_KEY=your-openrouter-key

# 0/unset: standard https://api.openai.com/v1 (temporary production route).
# 1: https://eu.api.openai.com/v1; the project must meet OpenAI's EU
# eligibility and retention requirements. See _ai/ISSUE-TRACKER.md #20.
# OPENAI_EU=0

# Stall watchdog for the chat SSE streams (tracker #25). The per-turn abort
# fires after this many milliseconds of *total provider silence* — an IDLE
# deadline, re-armed on every chunk/event, so long legitimate generations
# never trip it. Unset/0/invalid → default 240000 (4 min); there is no
# "disabled" state (the watchdog is the safety net against a hung provider
# holding the connection to Cloud Run's 3600 s ceiling).
# LLM_STREAM_DEADLINE_MS=240000

# ── MCP orchestration (docs/mcp-orchestration-plan.md) ───────────────────
# Two-phase retriever→writer chat flow. Retriever (OpenAI) gathers legal
# sources through the MCP tools into a dense brief; writer (full Desk prompt,
# no tools) streams the final answer from that brief. Off by default; only
# turns with live MCP tools orchestrate. Without MCP, the writer handles chat.
# Sol caches stable instructions for 30m and reuses retrieval tool history.
# Kill switch: unset EULEX_ORCHESTRATION.
# EULEX_ORCHESTRATION=1
# EULEX_RETRIEVER_MODEL=gpt-5.6-sol
# EULEX_WRITER_MODEL=gpt-5.6-sol

# ── Web Search providers (backend/src/lib/search) ────────────────────────
# The `web_search` LLM tool and the /search route call whichever of these
# providers has a key set. Auto-pick priority is: tavily → exa → parallel
# → you. Set at least one; setting multiple is fine — the LLM (or caller)
# can request a specific one via `provider: "exa" | "parallel" | ...`.
#
# Tavily — general-purpose, AI-optimised summaries.
#   Get a key: https://app.tavily.com (free tier available)
TAVILY_API_KEY=your-tavily-key
# Exa — neural/semantic search, best for technical / long-form content.
#   Get a key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your-exa-key
# Parallel — agentic LLM-objective search; multi-query under the hood.
#   Get a key: https://platform.parallel.ai
PARALLEL_API_KEY=your-parallel-key
# You.com — unified web + news, best for current events.
#   Get a key: https://api.you.com
YOU_API_KEY=your-you-key

# ── Email (chat share invites — routes/chatShares.ts) ────────────────────
# Provider selector. "brevo" (default) ships email through @getbrevo/brevo;
# "noop" logs to console only and is the right pick for local dev / CI.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key
# Brevo newsletter lists. Every registered user is added on first login and
# moved when they switch UI language (user_profiles.preferred_language).
# Unset LIST_ID = sync disabled. Unset LIST_ID_EN = everyone in LIST_ID.
# Prod/staging: hr → 50 ("EulexDesk"), en → 51 ("Eulex_en").
BREVO_SIGNUP_LIST_ID=
BREVO_SIGNUP_LIST_ID_EN=
EMAIL_FROM_ADDR=noreply@your-domain.example
EMAIL_FROM_NAME=Eulex Desk
# Number of days a share-invite link stays valid. Default 30.
CHAT_SHARE_TTL_DAYS=30

# ── vLLM (OpenAI-compatible endpoint) ────────────────────────────────────
VLLM_BASE_URL=https://your-vllm-endpoint.com/v1
VLLM_API_KEY=your-vllm-api-key
VLLM_MAIN_MODEL=your-main-model-name
VLLM_LIGHT_MODEL=your-light-model-name


# Live voice (mobile) — OpenAI Realtime. Model je namjerno konfigurabilan:
# prelazak na novi model = promjena env varijable, bez novog builda aplikacije.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Reasoning effort za Realtime 2.x (low|medium|high) — default medium
REALTIME_REASONING_EFFORT=medium

# gpt-live-1 (GPT-Live, GA since 2026-09) — second voice transport for the mobile
# app next to Realtime. Billed per second of voice; the delegated backend model and
# tools are billed separately. LIVE_ENABLED=true opens it for everyone; LIVE_USERS=<userId or e-mail,…> only
# for the listed users. Needs OPENAI_API_KEY.
# LIVE_ENABLED=false
# LIVE_USERS=
# LIVE_MODEL=gpt-live-1
# LIVE_ALPHA_HEADER=                       # only for a project still on the alpha (quicksilver=v3)
# LIVE_BACKEND_MODEL=gpt-5.6-terra          # Responses delegation model (billed)
# LIVE_BACKEND_REASONING_EFFORT=low         # low (default) | medium | high | none (omit field)
# LIVE_VOICE=marin                          # falls back to REALTIME_VOICE; built-in: alloy ash ballad
#                                           # beacon bossa cedar cinder coral delta echo gleam marin meridian
#                                           # quartz ripple sage shimmer stone tempo verse vesper willow,
#                                           # or voice_<id> for a custom (cloned) voice
# LIVE_DATA_CHANNEL_ALLOWLIST=true          # restrict what the phone may send over the data channel
# LIVE_TOOL_OUTPUT_MAX_CHARS=6000           # function outputs share a 32 KB buffer
# LIVE_DELEGATION=client                    # client (default: backend researches in the
#                                           # background and streams sentences to the live
#                                           # model, like "Her and Him") | responses (older path)
# LIVE_DELEGATION_MAX_TOOL_CALLS=5          # client mode: EULEX tool budget per question
# LIVE_DELEGATION_MAX_ROUNDS=4              # client mode: model↔tools rounds per question
# LIVE_DELEGATION_TIMEOUT_MS=45000          # client mode: per-request ceiling (voice waits)
# ── AdminMax · Baze (GET /adminmax/databases) ───────────────────────────
# Generic proxy to an external ops-inventory service. Unset → the tab reports
# "not available". Auth is a Google OIDC identity token minted from this
# backend's runtime service account; OPS_INVENTORY_TOKEN is a static bearer
# for local development only.
OPS_INVENTORY_URL=
# OPS_INVENTORY_TOKEN=
